# ─── app ──────────────────────────────────────────────────────────
# Local dev uses a file next to the schema; the container uses the volume.
DATABASE_URL="file:./dev.db"

# CHANGE BOTH OF THESE before the site is reachable from the internet.
ADMIN_PASSWORD="change-me"
AUTH_SECRET="change-me-to-a-long-random-string"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# International format, no + and no spaces. Also editable at /admin/settings.
WHATSAPP_NUMBER="218910000000"

# ─── docker compose ───────────────────────────────────────────────
# DATABASE_URL="file:/data/lirisha.db"   # the container's default
# APP_PORT=3000                          # host port when running without Caddy
# APP_IMAGE=ghcr.io/abdumurad/lirisha:latest   # pull instead of building

# Required only for the `edge` profile (Caddy + automatic HTTPS):
# DOMAIN=lirisha.ly
# TLS_EMAIL=hi@abdumurad.com

# "auto" seeds only a completely empty catalogue; "off" never seeds.
# SEED_ON_START=auto

# ─── the `tools` profile: container logs + stats in a browser ─────
# docker compose --profile edge --profile tools up -d
#
# Loopback by default — reach it with an SSH tunnel:
#   ssh -N -L 8080:127.0.0.1:8080 root@<host>   → http://localhost:8080
# DOZZLE_BIND=127.0.0.1:8080
#
# Required before exposing it via docker/caddy.d/logs.caddy. Leaving this at
# "none" on a public subdomain publishes customer names and phone numbers.
# DOZZLE_AUTH_PROVIDER=simple
#
# Empty shows every container on the host. Narrow with e.g.
#   DOZZLE_FILTER=label=com.docker.compose.project=lirisha

# Only for the `postgres` profile:
# POSTGRES_PASSWORD=change-me

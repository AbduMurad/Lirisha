# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never, the template always
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local database + generated client
prisma/*.db
prisma/*.db-journal
src/generated

# Prisma re-injects these on every `prisma generate`
.agents/
.claude/skills/prisma-*

# local docker verification artefacts
Dockerfile.verify
.sandbox-ca.crt

# operational notes — never commit these
SERVER-ACCESS.md

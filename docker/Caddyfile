{
	email {$TLS_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Product photography and the build's hashed assets are immutable.
	@immutable path /_next/static/* /images/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# The dashboard is never for search engines.
	@admin path /admin /admin/*
	header @admin X-Robots-Tag "noindex, nofollow"

	reverse_proxy app:3000
}

# Optional extra sites, none by default. A glob matching nothing is valid Caddy
# (checked), so this line is inert until you put a file there — see
# docker/caddy.d/logs.caddy.example for putting the log viewer on a subdomain.
# Files here are gitignored, so enabling one won't dirty the checkout and block
# a deploy's config sync.
import /etc/caddy/conf.d/*.caddy
